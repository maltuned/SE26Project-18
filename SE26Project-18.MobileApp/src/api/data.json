  "messages": [
    { "id": 1, "chat_id": 1, "sender_id": 2, "receiver_id": 1, "content": "你好，我对你的招募很感兴趣！", "created_at": "2024-06-01T10:05:30Z" },
    { "id": 2, "chat_id": 1, "sender_id": 1, "receiver_id": 2, "content": "欢迎欢迎，你平时打什么位置？", "created_at": "2024-06-01T10:10:00Z" },
    { "id": 3, "chat_id": 1, "sender_id": 2, "receiver_id": 1, "content": "我主要玩辅助，ADC也可以", "created_at": "2024-06-01T10:11:00Z" },
    { "id": 4, "chat_id": 1, "sender_id": 1, "receiver_id": 2, "content": "太好了，正好缺辅助，晚上一起排？", "created_at": "2024-06-01T10:12:00Z" },
    { "id": 5, "chat_id": 2, "sender_id": 4, "receiver_id": 3, "content": "你好！看到你的招募想加入，我玩上单和中单", "created_at": "2024-06-01T09:05:30Z" },
    { "id": 6, "chat_id": 2, "sender_id": 3, "receiver_id": 4, "content": "周本怎么打？我带奶妈", "created_at": "2024-06-01T09:10:00Z" },
    { "id": 7, "chat_id": 2, "sender_id": 4, "receiver_id": 3, "content": "速刷就行，我主C", "created_at": "2024-06-01T09:15:00Z" },
    { "id": 8, "chat_id": 3, "sender_id": 6, "receiver_id": 5, "content": "你好，我有对应命途的角色，可以组队吗？", "created_at": "2024-06-01T08:05:30Z" },
    { "id": 9, "chat_id": 3, "sender_id": 5, "receiver_id": 6, "content": "可以的，你练度怎么样？", "created_at": "2024-06-01T08:10:00Z" },
    { "id": 10, "chat_id": 3, "sender_id": 6, "receiver_id": 5, "content": "还行，满星深渊没问题", "created_at": "2024-06-01T08:15:00Z" },
    { "id": 11, "chat_id": 4, "sender_id": 3, "receiver_id": 1, "content": "排位三排我来了", "created_at": "2024-06-01T07:05:30Z" },
    { "id": 12, "chat_id": 4, "sender_id": 1, "receiver_id": 3, "content": "好的，还差一个人", "created_at": "2024-06-01T07:10:00Z" },
