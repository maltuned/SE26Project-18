{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseValidation": {
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 2
  },
  "AdminBootstrap": {
    "Enabled": false,
    "Username": "",
    "Password": ""
  },
  "MediaStorage": {
    "RootPath": "media",
    "MaxUploadBytes": 5242880,
    "MaxPixels": 12000000
  },
  "Jwt": {
    "Issuer": "SE26Project-18.Api",
    "Audience": "SE26Project-18.MobileApp",
    "AccessTokenExpiryMinutes": 30,
    "RefreshTokenExpiryDays": 7
  },
  "Embedding": {
    "Model": "BAAI/bge-m3",
    "Dimension": 1024,
    "SendDimensions": false,
    "RequestBatchSize": 32
  },
  "EmbeddingSync": {
    "BatchSize": 100,
    "MaxBatchWaitMilliseconds": 1000,
    "PrefetchCount": 200,
    "ProcessingTimeoutSeconds": 120,
    "MilvusBatchSize": 100,
    "OutboxPollMilliseconds": 500,
    "OutboxPublishBatchSize": 100,
    "OutboxLeaseSeconds": 30,
    "OutboxRetentionHours": 72
  }
}
